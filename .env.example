# Application Configuration
APP_NAME="Customer Audience Engine"
APP_ENV="development"
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL 15+)
# Format: postgresql+psycopg2://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/customer_engine"

# Local SQLite fallback (used when local PostgreSQL instance is offline):
# DATABASE_URL="sqlite:///./customer_engine.db"

# Automated Testing Configuration (Isolated In-Memory Database)
TEST_DATABASE_URL="sqlite:///:memory:"
